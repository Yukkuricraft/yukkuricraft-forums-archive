# Copy to .env and fill in before running anything:  cp .env.example .env

# --- Postgres -----------------------------------------------------------
# Used by both the app (to build DB_URL) and the migration job.
# Keep the password alphanumeric: it is interpolated into a connection URL
# without percent-encoding.
POSTGRES_USER=yc
POSTGRES_PASSWORD=changeMeBeforeDeploying
POSTGRES_DB=yc_forums_archive

# docker-compose.yaml sets DB_URL for the app service automatically, from the
# POSTGRES_* values above, so this line normally stays commented out. The
# migrate job does not read DB_URL at all — it builds its own connection string
# from those same values. Uncomment this only for local non-container
# development (`yarn dev` against a Postgres reachable from the host):
# DB_URL=postgresql://yc:changeMeBeforeDeploying@localhost:5432/yc_forums_archive

# --- Application --------------------------------------------------------
# nuxt-auth-utils session sealing key. Must be at least 32 characters.
NUXT_SESSION_PASSWORD=change-me-to-a-long-random-string-at-least-32
NUXT_OAUTH_DISCORD_CLIENT_ID=
NUXT_OAUTH_DISCORD_CLIENT_SECRET=
NUXT_OAUTH_DISCORD_REDIRECT_URL=https://example.com/oauth_callback/discord

# --- Migration only -----------------------------------------------------
# Legacy source image. mysql-src credentials are fixed literals in
# docker-compose.yaml and are deliberately not configurable here.
MYSQL_IMAGE=mysql:5.7

# gs:// URL of the mysqldump. Ignored entirely when a .sql or .sql.gz is
# present in DUMP_DIR.
GCS_DUMP_URL=

# Host directories mounted into the migration container. Both may be empty.
DUMP_DIR=./.dump
SECRETS_DIR=./.secrets

# Path to the service account key *inside* the migration container. The default
# matches where SECRETS_DIR is mounted; change it only if you rename the key.
GOOGLE_APPLICATION_CREDENTIALS=/secrets/sa.json

# Escape hatches, normally left empty.
# MIGRATE_FORCE=1     skip the already-migrated guard (does NOT clear data)
# KEEP_RAW_SCHEMA=1   keep the intermediate yc_forum_archive schema
MIGRATE_FORCE=
KEEP_RAW_SCHEMA=
